# Electro Galaxy - Supabase configuration
# Copy this file to ".env" (or ".env.local") and fill in real values.
# Never commit your real .env file - it is gitignored.

# Project URL (Supabase Dashboard -> Project Settings -> Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key (safe to expose in client code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (SECRET! server-side only). Used by scripts/seed.ts and to
# publish product reviews after moderation. Never prefix with NEXT_PUBLIC_.
# Get it from: Project Settings -> Data API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI key for the Galaxy Assistant chatbot (server-side only).
# NEVER prefix with NEXT_PUBLIC_ or the secret will ship to browsers.
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Supabase Cloud Database (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only key for the Galaxy Assistant (do not use a NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=your-gemini-api-key

# Configure Supabase Auth redirect URLs to include:
# http://localhost:3000/auth/reset-password (and your deployed equivalent)
